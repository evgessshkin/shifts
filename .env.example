# Copy this file to .env and fill in your values. Never commit .env.
SHIFTS_URL=https://part-time.gymbeam.com/news
SHIFTS_COOKIE=session_id=...; cf_clearance=...; frontend_lang=en_US; tz=Europe/Bratislava
# Must be the exact User-Agent of the browser the cookies came from
SHIFTS_USER_AGENT=Mozilla/5.0 (...)
# Optional: lets the bot log in again by itself when the session expires
SHIFTS_LOGIN=you@example.com
SHIFTS_PASSWORD=your password
TG_TOKEN=123456:ABC-token-from-BotFather
TG_CHAT_ID=123456789
AUTO_SUBSCRIBE=0
LUNCH=no
# Auto-book only this department (messages still come for all departments)
BOOK_ONLY=IMPORT
